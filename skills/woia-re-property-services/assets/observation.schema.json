{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Property Services operation observation envelope",
  "type": "object",
  "required": [
    "account_id",
    "observation_id",
    "source_key",
    "cycle_id",
    "round",
    "source_ref",
    "evidence_ref",
    "observed_at",
    "status",
    "query_result"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "DEBT",
        "NO_DEBT",
        "UNKNOWN"
      ]
    },
    "query_result": {
      "enum": [
        "SUCCESS",
        "FAILED",
        "UNAVAILABLE"
      ]
    }
  }
}
